{
  "name": "gridxcel",
  "version": "0.1.0",
  "description": "Streaming XLSX, CSV, SYLK and DIF for Node.js and the browser. Zero dependencies, bounded memory, ~3.4x faster than SheetJS, typed errors.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./compat": {
      "types": "./src/compat.d.ts",
      "default": "./src/compat.js"
    },
    "./csv": {
      "types": "./src/csv.d.ts",
      "default": "./src/csv.js"
    },
    "./json": {
      "types": "./src/json.d.ts",
      "default": "./src/json.js"
    },
    "./xml": {
      "types": "./src/xml.d.ts",
      "default": "./src/xml.js"
    },
    "./numfmt": {
      "types": "./src/numfmt.d.ts",
      "default": "./src/numfmt.js"
    },
    "./zip": {
      "types": "./src/zip.d.ts",
      "default": "./src/zip.js"
    },
    "./formats": {
      "types": "./src/formats.d.ts",
      "default": "./src/formats.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs/API.md",
    "docs/QUICKSTART.md",
    "docs/COOKBOOK.md",
    "docs/MIGRATION.md",
    "docs/LIMITATIONS.md",
    "docs/ARCHITECTURE.md",
    "docs/BROWSER.md",
    "docs/COMPARISON.md",
    "docs/PERFORMANCE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "scripts/run-tests.mjs"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs",
    "interop": "node scripts/interop.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:exports": "node scripts/check-exports-doc.mjs",
    "check": "npm run check:docs && npm run check:exports && npm test",
    "bench": "node scripts/bench.mjs",
    "bench:scaling": "node --expose-gc scripts/bench-scaling.mjs",
    "golden": "python test/make_golden.py",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "csv",
    "tsv",
    "dsv",
    "ooxml",
    "openxml",
    "workbook",
    "worksheet",
    "spreadsheetml",
    "streaming",
    "stream",
    "parser",
    "reader",
    "writer",
    "sheetjs",
    "xlsx-alternative",
    "zero-dependency",
    "esm",
    "typescript",
    "number-format",
    "ssf",
    "zip",
    "sylk",
    "dif",
    "exceljs-alternative",
    "sheetjs-alternative",
    "no-dependencies",
    "types",
    "browser",
    "deno",
    "bun",
    "workers",
    "bounded-memory",
    "large-files"
  ],
  "dependencies": {},
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdisonJwa/gridxcel.git",
    "directory": "."
  },
  "homepage": "https://github.com/EdisonJwa/gridxcel#readme",
  "bugs": {
    "url": "https://github.com/EdisonJwa/gridxcel/issues"
  },
  "author": "gridxcel contributors",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "browser": {
    "./src/platform.js": "./src/platform.browser.js"
  }
}
